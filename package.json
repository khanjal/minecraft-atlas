{
  "name": "minecraft-atlas",
  "version": "0.1.0",
  "description": "Merged, versioned Minecraft data (items, entities, recipes, and more) drawn from PrismarineJS/minecraft-data and misode/mcmeta, plus a curated overlay.",
  "main": "built/index.js",
  "types": "built/index.d.ts",
  "files": [
    "built"
  ],
  "scripts": {
    "build": "tsc",
    "generate": "ts-node scripts/generate.ts",
    "generate:recipes": "ts-node scripts/generateRecipes.ts",
    "generate:base": "ts-node scripts/generateBase.ts",
    "generate:bedrock-recipes": "ts-node scripts/generateBedrockRecipes.ts",
    "generate:bedrock-entities": "ts-node scripts/generateBedrockEntities.ts",
    "generate:entity-behavior": "ts-node scripts/generateEntityBehavior.ts",
    "test": "node --require ts-node/register --test \"src/**/*.test.ts\""
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "@types/node": "^22.20.1"
  }
}
