{
    "compilerOptions": {
        "outDir": "./built",
        "target": "es2022",
        "lib": ["es2022"],
        "skipLibCheck": true,
        "module": "commonjs",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "strict": true,
        "pretty": true,
        "removeComments": true
    },
    "include": [
        "src/**/*"
    ]
}
